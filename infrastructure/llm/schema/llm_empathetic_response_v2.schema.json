{
  "name": "LLMEmpatheticResponse",
  "strict": false,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "inferredJourneys": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Journey"
        },
        "minItems": 0,
        "maxItems": 2
      },
      "inferredLoveTypes": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/LoveType"
        },
        "minItems": 0,
        "maxItems": 3
      },
      "inferredRelationalNeeds": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/RelationalNeed"
        },
        "minItems": 0,
        "maxItems": 3
      },
      "inferredEnumsForRitualSuggestion": {
        "type": "boolean",
        "description": "Has enum values been successfully inferred for Journey, LoveType and RelationshipNeed?"
      },
      "readyForRitualSuggestion": {
        "type": "boolean",
        "description": "Does LLM have all the information to suggest a ritual pack?"
      },
      "response": {
        "type": "string",
        "description": "Empathetic response for the user query"
      }
    },
    "required": [
      "readyForRitualSuggestion",
      "response"
    ],
    "$defs": {
      "Journey": {
        "description": "The user's current emotional or relational phase in their journey.",
        "type": "string",
        "enum": [
          "FEELING_DISTANT",
          "LOVE_FEELS_FLAT",
          "LOST_TOUCH",
          "CARRYING_TOO_MUCH",
          "WEATHERING_A_STORM",
          "BRIDGING_THE_DIVIDE",
          "LEARNING_TO_HEAR_EACH_OTHER",
          "MAKING_SPACE_FOR_US",
          "KEEP_THE_LOVE_ALIVE",
          "GROW_AND_EVOLVE_TOGETHER",
          "RETURN_TO_SELF",
          "CELEBRATE_US"
        ]
      },
      "LoveType": {
        "description": "Primary love types expressed or sought by the user.",
        "type": "string",
        "enum": [
          "BELONG",
          "FIRE",
          "SPARK",
          "CARE",
          "SELF",
          "BUILD",
          "GROW",
          "BEYOND",
          "GRACE"
        ]
      },
      "RelationalNeed": {
        "description": "Core relational needs present in the user's experience.",
        "type": "string",
        "enum": [
          "CONNECTION",
          "INTIMACY",
          "UNDERSTANDING",
          "ACCEPTANCE_AND_FORGIVENESS",
          "TRUST_AND_SAFETY",
          "SUPPORT",
          "BALANCE_AND_FAIRNESS",
          "COMMUNICATION",
          "PLAY_AND_JOY",
          "GROWTH",
          "GRATITUDE_AND_APPRECIATION",
          "PRESENCE_AND_QUALITY_TIME",
          "SPACE"
        ]
      }
    }
  }
}